<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/item_margin_medium">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/track_image"
        android:layout_width="@dimen/image_size_small"
        android:layout_height="@dimen/image_size_small"
        android:contentDescription="@string/item_track_content_descriptor"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Musify.ImageRounded"
        tools:background="@drawable/img_playlist_placeholder" />

    <TextView
        android:id="@+id/track_title"
        android:textAppearance="@style/TextAppearance.Musify"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_margin_medium"
        android:gravity="start"
        app:layout_constraintBottom_toBottomOf="@id/track_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/track_image"
        app:layout_constraintTop_toTopOf="@id/track_image"
        tools:text="Title" />

</androidx.constraintlayout.widget.ConstraintLayout>
